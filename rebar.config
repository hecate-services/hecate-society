%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_society.
%%
%% THIS EXISTS SO A BELIEF CAN CROSS BETWEEN MACHINES THAT DECIDE FOR THEMSELVES
%% WHETHER TO LET IT IN.
%%
%% An island is one node's piece of the world: a population of agents who hold
%% beliefs, teach them to each other, and check them against what they see. The
%% mesh between nodes is the border between their cultures, and a partition is a
%% barrier nobody chose. CHARTER.md says the rest.
%%
%% SCAFFOLD FIRST, ON PURPOSE AND FOR A RECORDED REASON. The release, the image,
%% the CI and the deployment are the tedious end and the one that is expensive to
%% retrofit. That end is finished before the interesting end starts, so no
%% increment is ever blocked waiting on plumbing.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) and the whole reckon-db stack transitively.
    %%
    %% The reckon-db applications start with hecate_om whether or not this
    %% service asks for a store. What `store_id/0' and `data_dir/0' add is the
    %% STORE, not the applications. The predecessor's rebar.config claimed
    %% otherwise for months while six of its thirty-one running applications
    %% quietly disproved it.
    {hecate_om, "~> 0.10"}
]}.

{project_plugins, [rebar3_lint]}.

%% The sibling services' block, verbatim, and it is load-bearing. Without it the
%% run ends on one `Unknown function macula:publish/4' for ever, because macula
%% arrives transitively through hecate_om and rebar3's default plt holds direct
%% deps only. A gate that is red for a reason nobody can fix is a gate everybody
%% learns to skip, and on the predecessor this one had twenty-three real warnings
%% hiding behind it.
{dialyzer, [
    {warnings, [no_unknown]},
    %% ⚠ COWBOY ARRIVES TRANSITIVELY THROUGH hecate_om, so it is not in the plt
    %% by default. The island's own page and its socket implement cowboy
    %% behaviours, and a behaviour nobody checks is a set of callbacks free to
    %% drift from what cowboy actually calls, in production only. Named directly
    %% rather than widening the plt to every transitive dep.
    {plt_extra_apps, [cowboy, ranch]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        reckon_db, reckon_evoq, reckon_gater, evoq,
        khepri, ra, horus, aten, seshat, gen_batch_server,
        gproc, msgpack, jsx
        %% ⚠ cowboy AND ranch ARE DELIBERATELY ABSENT HERE. See above.
    ]}
]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {hecate_society, "0.1.0"}, [hecate_society, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
